# Environment Configuration
# Copy this to .env and fill in your values

# LLM Configuration
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cuda

# Vector Store
VECTOR_STORE_COLLECTION=water_management_docs
VECTOR_STORE_PERSIST=./data/vector_store

# Performance
ENABLE_CACHING=true
CACHE_TTL=3600
GPU_MEMORY_FRACTION=0.8

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/rag_system.log

# Weather Configuration (for agricultural context enrichment)
# API Provider: "open-meteo" (free, no key) or "openweathermap" (requires key)
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=  # Only required for OpenWeatherMap
WEATHER_CACHE_TTL=1800

# Secure API
API_TITLE=Agriculture RAG API
API_VERSION=3.0.0
API_REQUIRE_AUTH=true
API_AUTH_MODE=local
API_ADMIN_USERNAME=admin
# Use a secret manager in production. Do not commit real values.
API_ADMIN_PASSWORD=
API_ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
OIDC_ISSUER=
OIDC_AUDIENCE=
API_ALLOWED_ORIGINS=

# Model provider: local or bedrock
RAG_PROVIDER=local
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Approved remote MCP HTTP endpoints, comma-separated.
MCP_SERVER_URLS=
WEB_SEARCH_URL=https://html.duckduckgo.com/html/
API_REQUEST_TIMEOUT=20
API_RATE_LIMIT_PER_MINUTE=60
